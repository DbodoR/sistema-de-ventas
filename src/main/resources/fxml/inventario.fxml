<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.dbodor.sistemadeventas.Controllers.InventarioController">
   <children>
      <HBox alignment="TOP_CENTER" prefHeight="70.0" prefWidth="1257.0">
         <children>
            <Label styleClass="h2" text="Inventario">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="5.0">
         <children>
            <Label text="Buscar producto">
               <font>
                  <Font size="14.0" />
               </font></Label>
            <TextField fx:id="txtBuscar" prefWidth="350.0" promptText="Código de barras o nombre" />
         </children>
      </HBox>
      <HBox alignment="BOTTOM_LEFT" prefHeight="41.0" prefWidth="1257.0">
         <children>
            <Region prefHeight="200.0" prefWidth="200.0" />
            <Button cancelButton="true" maxHeight="-Infinity" mnemonicParsing="false" onAction="#editarProductos" prefHeight="35.0" prefWidth="76.0" styleClass="btn-primary" text="Editar">
               <font>
                  <Font size="16.0" />
               </font>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="inventarioTabla" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colCodigo" editable="false" minWidth="75.0" prefWidth="75.0" sortable="false" text="Código" />
          <TableColumn fx:id="colProducto" editable="false" minWidth="150.0" prefWidth="150.0" sortable="false" text="Producto" />
            <TableColumn fx:id="colCategoria" editable="false" minWidth="90.0" prefWidth="90.0" sortable="false" text="Categoria" />
            <TableColumn fx:id="colCosto" editable="false" minWidth="120.0" prefWidth="120.0" sortable="false" text="Costo" />
            <TableColumn fx:id="colPrecio" editable="false" minWidth="120.0" prefWidth="120.0" sortable="false" text="Precio venta" />
            <TableColumn fx:id="colStock" editable="false" minWidth="90.0" prefWidth="90.0" sortable="false" text="Stock" />
            <TableColumn fx:id="colPrecioVariable" editable="false" minWidth="80.0" sortable="false" text="Precio variable" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
